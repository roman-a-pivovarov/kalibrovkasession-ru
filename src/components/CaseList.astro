---
import {
  cases,
  corporateCases,
  featuredCases,
  formatLabel,
  type CaseStudy,
} from "../content/cases";

interface Props {
  variant: "featured" | "corporate" | "all";
}

const { variant } = Astro.props;

const list: readonly CaseStudy[] =
  variant === "featured"
    ? featuredCases()
    : variant === "corporate"
      ? corporateCases()
      : cases;
---

{
  list.length > 0 && (
    <div class="case-list">
      {list.map((item) => {
        const expanded = variant === "all" && item.featured && item.detail;
        return (
          <article
            class:list={["case", expanded && "case--lead"]}
            id={variant === "all" ? item.id : undefined}
          >
            <p class="meta">
              {item.period}
              {" · "}
              {item.industry}
              {" · "}
              {formatLabel[item.format]}
            </p>
            <h3>{item.client}</h3>
            <p class="case-task">{item.task}</p>
            <p>{expanded ? item.detail : item.summary}</p>
            {item.result && <p>{item.result}</p>}
            {variant !== "all" && (
              <a class="text-link" href={`/cases/#${item.id}`}>
                {item.detail ? "История целиком" : "В общем опыте"}
              </a>
            )}
          </article>
        );
      })}
    </div>
  )
}
