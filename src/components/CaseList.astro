---
import {
  cases,
  corporateCases,
  featuredCases,
  formatLabel,
  type CaseStudy,
} from "../content/cases";

interface Props {
  variant: "featured" | "corporate" | "all";
}

const { variant } = Astro.props;

const list: readonly CaseStudy[] =
  variant === "featured"
    ? featuredCases()
    : variant === "corporate"
      ? corporateCases()
      : cases;
---

{
  list.length > 0 && (
    <div class="case-list">
      {list.map((item) => (
        <article class="case" id={variant === "all" ? item.id : undefined}>
          <p class="meta">
            {item.client}. {item.industry}. {item.period}
          </p>
          <h3>{item.task}</h3>
          <p>{formatLabel[item.format]}</p>
          {
            item.media.map((image) => (
              <img src={image.src} alt={image.alt} />
            ))
          }
          <p>{variant === "all" ? (item.detail ?? item.summary) : item.summary}</p>
          <p>{item.work}</p>
          <p>{item.role}</p>
          {item.result && <p>{item.result}</p>}
          {variant !== "all" && (
            <a class="text-link" href={`/cases/#${item.id}`}>
              История целиком
            </a>
          )}
        </article>
      ))}
    </div>
  )
}
