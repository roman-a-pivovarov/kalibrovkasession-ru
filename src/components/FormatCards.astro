---
import { formats } from "../content/site";
---

<div class="cards">
  <article class="card">
    <h3>{formats.corporate.title}</h3>
    <p>{formats.corporate.text}</p>
    <a class="text-link" href={formats.corporate.href}>{formats.corporate.entry}</a>
  </article>
  <article class="card">
    <h3>{formats.personal.title}</h3>
    <p>{formats.personal.text}</p>
    <a class="text-link" href={formats.personal.href}>{formats.personal.entry}</a>
  </article>
</div>
