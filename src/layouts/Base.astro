---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import type { InquiryContext } from "../content/site";

interface Props {
  title: string;
  description: string;
  path: string;
  context: InquiryContext;
}

const { title, description, path, context } = Astro.props;
const canonical = new URL(path, Astro.site);
const palette = Astro.url.searchParams.get("palette");
const paletteName = palette === "green" || palette === "burgundy" ? palette : undefined;
---

<!doctype html>
<html lang="ru" data-palette={paletteName}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
  </head>
  <body>
    <a class="skip" href="#content">К содержанию</a>
    <SiteHeader path={path} context={context} />
    <main id="content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
