---
import Base from "../../layouts/Base.astro";
import Outcomes from "../../components/Outcomes.astro";
import Discuss from "../../components/Discuss.astro";
import { pages } from "../../content/copy";
import { formats } from "../../content/site";
---

<Base
  title={pages.approach.title}
  description={pages.approach.description}
  path="/approach/"
  context="general"
>
  <section class="hero">
    <div class="shell">
      <p class="kicker">Наш подход</p>
      <h1>{pages.approach.heading}</h1>
      <p class="lede">{pages.approach.lede}</p>
    </div>
  </section>

  <section class="block">
    <div class="shell">
      <h2>{pages.approach.pillarsTitle}</h2>
      <ul class="outcome-list">
        {
          pages.approach.pillars.map((item) => (
            <li>
              <strong>{item.title}</strong>
              {item.text}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="shell">
      <h2>{pages.approach.filtersTitle}</h2>
      <div class="filter-grid">
        {
          pages.approach.filters.map((item) => (
            <article class="card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
      <p class="lede">{pages.approach.refusal}</p>
    </div>
  </section>

  <section class="block tight">
    <div class="shell">
      <p class="lede">{pages.approach.bridge}</p>
    </div>
  </section>

  <Outcomes />

  <section class="block">
    <div class="shell actions">
      <a class="button" href={formats.corporate.href}>{formats.corporate.entry}</a>
      <a class="button" href={formats.personal.href}>{formats.personal.entry}</a>
    </div>
  </section>
  <Discuss context="general" />
</Base>
