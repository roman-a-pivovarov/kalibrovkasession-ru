---
import Base from "../layouts/Base.astro";
import FormatCards from "../components/FormatCards.astro";
import Outcomes from "../components/Outcomes.astro";
import CaseList from "../components/CaseList.astro";
import Discuss from "../components/Discuss.astro";
import ProgramTerms from "../components/ProgramTerms.astro";
import { featuredCases } from "../content/cases";
import { home } from "../content/copy";
import { formats } from "../content/site";

const featured = featuredCases();
---

<Base
  title={home.title}
  description={home.description}
  path="/"
  context="general"
>
  <section class="hero">
    <div class="shell">
      <h1>{home.heroTitle}</h1>
      <p class="hero-subtitle">{home.heroSubtitle}</p>
      <p class="lede">{home.heroLede}</p>
      <p class="lede">{home.heroFormats}</p>
      <div class="hero-actions">
        <a class="button" href={formats.corporate.href}>{formats.corporate.entry}</a>
        <a class="button" href={formats.personal.href}>{formats.personal.entry}</a>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="shell">
      <h2>{home.situationsTitle}</h2>
      <p class="lede">{home.situationsLede}</p>
      <ul class="outcome-list">
        {
          home.situations.map((item) => (
            <li>
              <strong>{item.title}</strong>
              {item.text}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="shell">
      <h2>{home.formatsTitle}</h2>
      <FormatCards />
    </div>
  </section>

  <Outcomes />

  <section class="block">
    <div class="shell">
      <h2>Как устроен выбор</h2>
      <p class="lede">
        Сначала понятно, куда есть смысл идти. Затем остаются варианты, которые проходят проверку,
        и действия, к которым можно вернуться.
      </p>
      <p><a class="text-link" href="/approach/">Подробнее о подходе</a></p>
    </div>
  </section>

  <section class="block">
    <div class="shell">
      <h2>{home.practiceTitle}</h2>
      <p class="lede">{featured.length > 0 ? home.practiceLede : home.practiceEmptyLede}</p>
      {featured.length > 0 && <CaseList variant="featured" />}
      <p><a class="text-link" href="/cases/">{home.practiceLink}</a></p>
    </div>
  </section>

  <section class="block">
    <div class="shell">
      <h2>{home.romanTitle}</h2>
      <p class="lede">{home.romanLede}</p>
      <p><a class="text-link" href="/roman/">{home.romanLink}</a></p>
    </div>
  </section>

  <section class="block">
    <div class="shell stack">
      <h2>{formats.personal.title}</h2>
      <p class="lede">{formats.personal.text}</p>
      <ProgramTerms />
      <p><a class="text-link" href="/personal/">Программа и ближайший выезд</a></p>
    </div>
  </section>

  <Discuss context="general" />
</Base>
