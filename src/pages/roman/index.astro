---
import Base from "../../layouts/Base.astro";
import Discuss from "../../components/Discuss.astro";
import { pages } from "../../content/copy";
---

<Base
  title={pages.roman.title}
  description={pages.roman.description}
  path="/roman/"
  context="general"
>
  <section class="hero">
    <div class="shell">
      <p class="kicker">О Романе</p>
      <h1>{pages.roman.heading}</h1>
      <p class="lede">{pages.roman.lede}</p>
      <p class="lede">{pages.roman.work}</p>
      <p class="actions">
        <a class="button" href="/approach/">Наш подход</a>
        <a class="button" href="/cases/">Кейсы и опыт</a>
      </p>
    </div>
  </section>
  <Discuss context="general" />
</Base>
